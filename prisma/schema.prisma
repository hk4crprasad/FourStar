generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  ROOM_SERVICE
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD_DEMO
  UPI_DEMO
  RAZORPAY_TEST
}

model Restaurant {
  id           String     @id
  name         String
  tagline      String
  logoUrl      String?
  location     String
  description  String
  isOpen       Boolean    @default(true)
  opensAt      String     @default("11:00")
  closesAt     String     @default("23:00")
  timeZone     String     @default("Asia/Kolkata")
  taxBps       Int        @default(500)
  deliveryFee  Int        @default(4900)
  categories   Category[]
  items        MenuItem[]
  orders       Order[]
  hotel        Hotel?
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  imageUrl     String?
  position     Int        @default(0)
  items        MenuItem[]

  @@unique([restaurantId, name])
}

model MenuItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  name         String
  description  String
  imageUrl     String
  price        Int
  vegetarian   Boolean
  inStock      Boolean    @default(true)
  popular      Boolean    @default(false)
  recommended  Boolean    @default(false)
  options      Json       @default("[]")
  position     Int        @default(0)
  orderItems   OrderItem[]

  @@index([restaurantId, categoryId])
}

model Customer {
  id        String  @id @default(cuid())
  mobile    String  @unique
  orders    Order[]
}

model Order {
  id           String        @id
  requestId    String        @unique
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  customerName String
  type         OrderType
  tableNumber  String?
  address      String?
  instructions String?
  payment      PaymentMethod
  paymentVerified Boolean @default(true)
  razorpayOrderId String? @unique
  razorpayPaymentId String? @unique
  status       OrderStatus   @default(PLACED)
  events       Json
  subtotal     Int
  tax          Int
  delivery     Int
  total        Int
  items        OrderItem[]
  reservationId String?
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  roomNumber   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, createdAt])
  @@index([reservationId])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  menuItemId  String?
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name        String
  unitPrice   Int
  quantity    Int
  options     String[]

  @@index([orderId])
  @@index([menuItemId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum RoomCondition {
  AVAILABLE
  MAINTENANCE
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  IN_PROGRESS
}

model Hotel {
  id           String       @id
  restaurantId String       @unique
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  name         String
  tagline      String
  location     String
  description  String
  heroUrl      String
  logoUrl      String?
  email        String
  phone        String
  timeZone     String       @default("Asia/Kolkata")
  roomTypes    RoomType[]
  rooms        Room[]
  amenities    Amenity[]
  reservations Reservation[]
}

model Amenity {
  id           String     @id @default(cuid())
  hotelId      String
  hotel        Hotel      @relation(fields: [hotelId], references: [id])
  name         String
  description  String
  hotelFeature Boolean    @default(false)
  roomTypes    RoomType[]

  @@unique([hotelId, name])
}

model RoomType {
  id           String       @id @default(cuid())
  hotelId      String
  hotel        Hotel        @relation(fields: [hotelId], references: [id])
  name         String
  description  String
  beds         String
  sizeM2       Int
  capacity     Int
  nightlyRate  Int
  position     Int          @default(0)
  isListed     Boolean      @default(true)
  images       RoomImage[]
  amenities    Amenity[]
  rooms        Room[]

  @@unique([hotelId, name])
}

model RoomImage {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  position   Int      @default(0)

  @@unique([roomTypeId, position])
}

model Room {
  id           String             @id @default(cuid())
  hotelId      String
  hotel        Hotel              @relation(fields: [hotelId], references: [id])
  roomTypeId   String
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id])
  number       String
  floor        String
  condition    RoomCondition      @default(AVAILABLE)
  housekeeping HousekeepingStatus @default(CLEAN)
  qrToken      String             @unique @default(uuid())
  reservations Reservation[]
  nights       ReservationNight[]

  @@unique([hotelId, number])
  @@index([roomTypeId])
}

model Guest {
  id           String        @id @default(cuid())
  mobile       String        @unique
  reservations Reservation[]
}

model Reservation {
  id           String              @id
  requestId    String              @unique
  hotelId      String
  hotel        Hotel               @relation(fields: [hotelId], references: [id])
  roomId       String
  room         Room                @relation(fields: [roomId], references: [id])
  guestId      String
  guest        Guest               @relation(fields: [guestId], references: [id])
  guestName    String
  email        String
  roomTypeName String
  checkIn      DateTime            @db.Date
  checkOut     DateTime            @db.Date
  guestCount   Int
  nightlyRate  Int
  total        Int
  payment      PaymentMethod
  status       ReservationStatus   @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  history      ReservationEvent[]
  nights       ReservationNight[]
  orders       Order[]

  @@index([hotelId, status, createdAt])
  @@index([roomId, status])
}

model ReservationEvent {
  id            String            @id @default(cuid())
  reservationId String
  reservation   Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  status        ReservationStatus
  at            DateTime         @default(now())

  @@index([reservationId, at])
}

// A room can hold one reservation per night, even across concurrent transactions.
model ReservationNight {
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id])
  night         DateTime    @db.Date
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@id([roomId, night])
  @@index([reservationId])
}
